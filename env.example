# Copia este archivo como  .env  (sin ".example") y pon tu clave real.
# El archivo .env NO se comparte ni se sube a ningún sitio público.

# Tu clave de Groq (empieza por "gsk_...")
GROQ_API_KEY=pega_aqui_tu_clave_de_groq

# (Opcional) cambia el modelo si lo necesitas
GROQ_MODELO=llama-3.3-70b-versatile

# (Opcional) puerto local
PORT=8000

# (Opcional) si cambias la hoja publicada, actualiza esta URL
# SHEET_CSV_URL=https://docs.google.com/.../pub?gid=...&single=true&output=csv
